# Copy to vaultwarden.env, chmod 600.
DOMAIN=https://vault.cloud.example.com
ROCKET_PORT=8080
ROCKET_WORKERS=4

# true only long enough to create your own account, then false for good
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=false
SHOW_PASSWORD_HINT=false
WEB_VAULT_ENABLED=true

# No ADMIN_TOKEN on purpose: with none set, /admin returns 404 to everyone.

# CrowdSec reads this log for failed logins.
LOG_FILE=/data/vaultwarden.log
LOG_LEVEL=warn
EXTENDED_LOGGING=true
IP_HEADER=X-Real-IP

PUSH_ENABLED=false
TZ=America/Chicago
