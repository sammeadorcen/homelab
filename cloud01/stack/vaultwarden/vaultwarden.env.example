# Copy to vaultwarden.env, chmod 600.
DOMAIN=https://vault.cloud.example.com
ROCKET_PORT=8080
ROCKET_WORKERS=4

# true only long enough to create your own account, then false for good
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=false
SHOW_PASSWORD_HINT=false
WEB_VAULT_ENABLED=true

# Admin panel token: an Argon2id hash, single-quoted so the $ signs stay literal.
#   echo -n 'password' | argon2 "$(openssl rand -base64 32)" -e -id -k 65540 -t 3 -p 4
# Served only on vault-admin.<CLOUD_DOMAIN> (mesh-only); the public name has no /admin route.
ADMIN_TOKEN='$argon2id$v=19$m=65540,t=3,p=4$replace-me'

# CrowdSec reads this log for failed logins.
LOG_FILE=/data/vaultwarden.log
LOG_LEVEL=warn
EXTENDED_LOGGING=true
IP_HEADER=X-Real-IP

PUSH_ENABLED=false
TZ=America/Chicago
