# Copy to .env and `chmod 600 .env`. Never commit the real file.
TZ=America/Chicago

# Parent domain for every cloud01 hostname: vault.<CLOUD_DOMAIN>, grafana.<CLOUD_DOMAIN> …
# Must match the wildcard in traefik/traefik.yml.
CLOUD_DOMAIN=cloud.example.com

# Cloudflare → My Profile → API Tokens → "Edit zone DNS" template, scoped to one zone.
CF_API_TOKEN=replace-me

# `id -u`:`id -g` of the admin user
PUID_PGID=1000:1000

# Alert email (Grafana; Uptime Kuma uses the same values in its UI).
# Google account → Security → 2-Step Verification → App passwords.
ALERT_EMAIL=admin@example.com
SMTP_PASSWORD=replace-me          # Workspace app password: Grafana alerts and Vaultwarden email

# Homepage dashboard widgets (see docs/monitoring.md)
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-me
# docker compose exec crowdsec cscli machines add homepage --auto -f -
CROWDSEC_HOMEPAGE_PASSWORD=replace-me
# Google Calendar → Settings → your calendar → Integrate calendar →
# "Secret address in iCal format". Treat it like a password.
CALENDAR_ICAL_URL=https://calendar.google.com/calendar/ical/you%40example.com/private-replace-me/basic.ics
