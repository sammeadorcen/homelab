# Cards for the dashboard. Internal URLs (http://grafana:3000 …) talk to
# containers directly over the compose network; https://…cloud.example.com
# URLs go through Traefik and need the bridge subnet in mesh-only.

- Calendar:
    - Upcoming:
        icon: mdi-calendar-month-outline
        widget:
          type: calendar
          view: agenda
          maxEvents: 8
          showTime: true
          timezone: America/Chicago
          integrations:
            - type: ical
              url: "{{HOMEPAGE_VAR_CALENDAR_URL}}"   # secret iCal link, from .env
              name: Calendar
              color: blue

- Servers:
    - cloud01:
        href: https://manage.cloud.example.com        # Cockpit
        siteMonitor: https://manage.cloud.example.com
        icon: mdi-cloud-outline
        description: Cloud VPS · mesh control plane and public edge
        widget:
          type: prometheusmetric
          url: http://prometheus:9090
          refreshInterval: 15000
          metrics:
            - label: CPU
              query: 100 - 100 * avg(rate(node_cpu_seconds_total{host="cloud01",mode="idle"}[5m]))
              format: { type: number, suffix: "%", options: { maximumFractionDigits: 0 } }
            - label: RAM
              query: 100 * (1 - node_memory_MemAvailable_bytes{host="cloud01"} / node_memory_MemTotal_bytes{host="cloud01"})
              format: { type: number, suffix: "%", options: { maximumFractionDigits: 0 } }
            - label: Disk
              query: 100 - 100 * node_filesystem_avail_bytes{host="cloud01",mountpoint="/",fstype!="tmpfs"} / node_filesystem_size_bytes{host="cloud01",mountpoint="/",fstype!="tmpfs"}
              format: { type: number, suffix: "%", options: { maximumFractionDigits: 0 } }
            - label: Uptime
              query: (time() - node_boot_time_seconds{host="cloud01"}) / 86400
              format: { type: number, suffix: " d", options: { maximumFractionDigits: 1 } }
    - onprem01:
        href: https://manage.example.com              # Cockpit
        siteMonitor: https://manage.example.com
        icon: mdi-home-outline
        description: Home · game servers and media
        widget:
          type: prometheusmetric
          url: http://prometheus:9090
          refreshInterval: 15000
          metrics:
            - label: CPU
              query: 100 - 100 * avg(rate(node_cpu_seconds_total{host="onprem01",mode="idle"}[5m]))
              format: { type: number, suffix: "%", options: { maximumFractionDigits: 0 } }
            - label: RAM
              query: 100 * (1 - node_memory_MemAvailable_bytes{host="onprem01"} / node_memory_MemTotal_bytes{host="onprem01"})
              format: { type: number, suffix: "%", options: { maximumFractionDigits: 0 } }
            - label: Disk
              query: 100 - 100 * node_filesystem_avail_bytes{host="onprem01",mountpoint="/",fstype!="tmpfs"} / node_filesystem_size_bytes{host="onprem01",mountpoint="/",fstype!="tmpfs"}
              format: { type: number, suffix: "%", options: { maximumFractionDigits: 0 } }
            - label: Uptime
              query: (time() - node_boot_time_seconds{host="onprem01"}) / 86400
              format: { type: number, suffix: " d", options: { maximumFractionDigits: 1 } }

- Network & security:
    - NetBird:
        icon: netbird.png
        href: https://nb.cloud.example.com
        description: Peers, users, access policies
        siteMonitor: https://nb.cloud.example.com
    - Traefik:
        icon: traefik.png
        href: https://traefik.cloud.example.com/dashboard/
        description: Routes and certificates
        server: cloud01
        container: traefik
        widget:
          type: traefik
          url: https://traefik.cloud.example.com
    - CrowdSec:
        icon: crowdsec.png
        description: Blocked attackers
        server: cloud01
        container: crowdsec
        widget:
          type: crowdsec
          url: http://crowdsec:8080
          username: homepage
          password: "{{HOMEPAGE_VAR_CROWDSEC_PASSWORD}}"
    - Vaultwarden:
        icon: vaultwarden.png
        href: https://vault.cloud.example.com
        description: Passwords (public)
        siteMonitor: https://vault.cloud.example.com/alive
        server: cloud01
        container: vaultwarden

- Monitoring:
    - Uptime Kuma:
        icon: uptime-kuma.png
        href: https://status.cloud.example.com
        description: Up/down checks
        server: cloud01
        container: uptime-kuma
        widget:
          type: uptimekuma
          url: http://uptime-kuma:3001
          slug: homelab
    - Grafana:
        icon: grafana.png
        href: https://grafana.cloud.example.com
        description: Graphs and alerts
        server: cloud01
        container: grafana
        widget:
          type: grafana
          url: http://grafana:3000
          username: "{{HOMEPAGE_VAR_GRAFANA_USER}}"
          password: "{{HOMEPAGE_VAR_GRAFANA_PASSWORD}}"
    - Prometheus:
        icon: prometheus.png
        href: https://prometheus.cloud.example.com
        description: Metrics collection
        server: cloud01
        container: prometheus
        widget:
          type: prometheus
          url: http://prometheus:9090
    - Dozzle:
        icon: dozzle.png
        href: https://logs.cloud.example.com
        description: Logs for both servers
        server: cloud01
        container: dozzle

- Games & media:
    - Minecraft:
        icon: minecraft.png
        description: mc.example.com
        widget:
          type: minecraft
          url: udp://mc.example.com:25565
    - Pelican Panel:
        icon: mdi-gamepad-variant-outline
        href: https://panel.example.com
        description: Game server control
        siteMonitor: https://panel.example.com
        server: onprem01
        container: pelican
    - Wings:
        icon: mdi-server-network
        description: Runs the game servers
        server: onprem01
        container: wings
    - AIOStreams:
        icon: mdi-play-box-multiple-outline
        href: https://aio.example.com
        description: Streams, filters, Apple TV server
        siteMonitor: https://aio.example.com/api/v1/status
        server: onprem01
        container: aiostreams
    - AIOMetadata:
        icon: mdi-movie-search-outline
        href: https://meta.example.com/configure
        description: Posters and catalogs (TMDB)
        siteMonitor: https://meta.example.com/health
        server: onprem01
        container: aiometadata

- Tools:
    - Edit this page:
        icon: filebrowser.png
        href: https://files.cloud.example.com
        description: Filebrowser → services.yaml
    - Homelab docs:
        icon: mdi-book-open-variant
        href: https://example.com/docs
        description: Public write-up
