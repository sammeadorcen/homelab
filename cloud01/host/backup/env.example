# /root/restic/env  (root:root, chmod 600). Never commit the real file.
export AWS_ACCESS_KEY_ID="replace-me"          # bucket-limited key
export AWS_SECRET_ACCESS_KEY="replace-me"
export RESTIC_REPOSITORY="s3:https://<region>.linodeobjects.com/<this-server>-backups"
export RESTIC_PASSWORD_FILE=/root/restic/password   # openssl rand -base64 32
export HC_URL="https://hc-ping.com/replace-me"      # healthchecks.io, period 1d, grace 6h
