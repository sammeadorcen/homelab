# Copy to .env and `chmod 600 .env`. Never commit the real file.
TZ=America/Chicago
DOMAIN=example.com

# Same scope as cloud01's: "Edit zone DNS", one zone.
CF_API_TOKEN=replace-me

# This box's NetBird address:  netbird status | grep "NetBird IP"
MESH_IP=100.64.0.10

# The real stack_default subnet and gateway — don't assume daemon.json's pool:
#   docker network inspect stack_default --format '{{range .IPAM.Config}}{{.Subnet}} {{.Gateway}}{{end}}'
BRIDGE_SUBNET=172.18.0.0/16
BRIDGE_GATEWAY=172.18.0.1

PUID_PGID=1000:1000

# AIOStreams + AIOMetadata (guide: AIOStreams Guide, section 3.1)
AIO_SECRET_KEY=replace-me            # openssl rand -hex 32 — never change after first start
AIO_ADMIN_PASSWORD=replace-me        # AIOStreams dashboard login, username "sam"
META_ADMIN_KEY=replace-me            # openssl rand -hex 32
TMDB_API_KEY=replace-me              # themoviedb.org → Settings → API (v3 key)
