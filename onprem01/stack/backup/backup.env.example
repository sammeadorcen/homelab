# Copy to backup.env, chmod 600. Separate bucket + key from cloud01's,
# so one leaked credential can't reach both.
export AWS_ACCESS_KEY_ID="replace-me"
export AWS_SECRET_ACCESS_KEY="replace-me"
export RESTIC_REPOSITORY="s3:https://<region>.linodeobjects.com/<bucket>"
export RESTIC_PASSWORD_FILE="/srv/stack/backup/restic-password"
export HC_URL=""
